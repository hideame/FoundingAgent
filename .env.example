# Database Configuration
DATABASE_URL=mysql+aiomysql://founding_user:founding_pass@localhost:3306/founding_agent

# Google Cloud / Vertex AI Configuration
# プロジェクトID（Google Cloud Consoleで確認）
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# リージョン（推奨: us-central1 または asia-northeast1）
GOOGLE_CLOUD_LOCATION=us-central1

# Note: ローカル開発では Application Default Credentials (ADC) が必要です
# 以下のコマンドを実行してください:
#   gcloud auth application-default login

# Application Settings
DEBUG=True
